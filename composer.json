{
    "name": "roadrunner/grpc",
    "type": "library",
    "description": "gRPC server for PHP: serve gRPC services from RoadRunner PHP workers",
    "keywords": [
        "roadrunner",
        "grpc",
        "protobuf",
        "rpc",
        "server",
        "microservices"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Anton Titov",
            "homepage": "https://github.com/wolfy-j"
        },
        {
            "name": "Pavel Buchnev",
            "homepage": "https://github.com/butschster"
        },
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Maksim Smakouz",
            "homepage": "https://github.com/msmakouz"
        },
        {
            "name": "RoadRunner Community",
            "homepage": "https://github.com/roadrunner-server/roadrunner/graphs/contributors"
        }
    ],
    "homepage": "https://roadrunner.dev/",
    "support": {
        "docs": "https://docs.roadrunner.dev/docs/grpc/grpc",
        "issues": "https://github.com/roadrunner-server/roadrunner/issues",
        "source": "https://github.com/roadrunner-php/grpc",
        "forum": "https://forum.roadrunner.dev/",
        "chat": "https://discord.gg/V6EK4he"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/roadrunner-server"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "google/common-protos": "^3.1|^4.0",
        "google/protobuf": "^3.7 || ^4.0 || ^5.0",
        "roadrunner/goridge": "^4.5",
        "roadrunner/worker": "^3.8",
        "spiral/roadrunner": "^3.0",
        "symfony/polyfill-php83": "^1.27"
    },
    "require-dev": {
        "jetbrains/phpstorm-attributes": "^1.0",
        "mockery/mockery": "^1.6",
        "spiral/code-style": "^2.3.1",
        "spiral/dumper": "^3.3",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "replace": {
        "spiral/roadrunner-grpc": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\RoadRunner\\GRPC\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GPBMetadata\\": "tests/generated/GPBMetadata",
            "Service\\": "tests/generated/Service",
            "Spiral\\RoadRunner\\GRPC\\Tests\\": "tests"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "test": "testo"
    },
    "config": {
        "audit": {
            "ignore": {
                "GHSA-g9pc-8g42-g6vq": "False positive: the range < 2025.1.0 also matches RoadRunner 3.x, which is not affected"
            }
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
